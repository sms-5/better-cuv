{
  "manifest_version": 3,
  "name": "Better SED",
  "version": "0.1.0",
  "description": "Modo oscuro, interfaz minimalista y sesión activa para SED (ex CUV).",
  "permissions": ["storage"],
  "action": {
    "default_title": "Better SED",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cuv-fceyt.unse.edu.ar/*"],
      "js": ["content.js"],
      "css": ["darkmode.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
